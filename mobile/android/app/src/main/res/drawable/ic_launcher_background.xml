<?xml version="1.0" encoding="utf-8"?>
<!-- ===========================================================================
     Adaptive Icon 背景：深靛蓝渐变
     Freelance Hub 品牌色：专业、可靠、聚焦商业场景
     108x108dp，会被启动器遮罩裁切为圆形/方形/圆角方形等
     =========================================================================== -->
<vector
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0h108v108h-108z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt" name="android:fillColor">
            <gradient
                android:startX="0"
                android:startY="0"
                android:endX="108"
                android:endY="108"
                android:startColor="#FF1E293B"
                android:endColor="#FF0F172A"
                android:type="linear" />
        </aapt:attr>
    </path>
    <!-- 右下角微弱光晕，增加层次感 -->
    <path
        android:pathData="M108,108 L108,55 A55,55 0 0,1 55,108 Z"
        android:fillColor="#1AF59E0B"
        android:fillAlpha="0.15" />
</vector>
