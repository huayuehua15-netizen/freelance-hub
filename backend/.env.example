# ===== Freelance Hub Backend 环境变量样例 =====
# 复制为 .env 并填写真实值。生产环境 (NODE_ENV=production) 会强制校验带密钥的项。

# 运行环境
NODE_ENV=development
PORT=3001

# 数据库
MONGODB_URI=mongodb://localhost:27017/freelance_hub

# JWT 密钥（生产必填，dev 有默认 fallback）
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES=1h
JWT_REFRESH_EXPIRES=30d

# bcrypt 加密轮数（12 为推荐值，兼顾安全与性能）
BCRYPT_ROUNDS=12

# RevenueCat
# webhookSecret: RC 后台 → Project settings → Webhooks → Authorization header（生产必填）
REVENUECAT_WEBHOOK_SECRET=dev_webhook_secret
# apiKey: RC 后台 → Project settings → API keys → Secret API key（sk_ 开头）
# 用于后端出站校验订阅状态（GET /v1/subscribers/{app_user_id}）。
# 注意：这里要 Secret API key，不是 Public SDK key（goog_/appl_/rc_ 开头的是客户端用的）。
# 未配置时出站校验自动跳过（dev 跳过，prod 告警），不影响 webhook 收单。
REVENUECAT_API_KEY=dev_api_key

# 前端地址（CORS / 邮件链接等）
CLIENT_URL=http://localhost:5173

# 演示开关：仅本地/联调显式设为 true 时，注册用户默认 annual（+1年）。
# 生产环境 (NODE_ENV=production) 会被 config/env.js 强制拒绝，防止误上线全员年卡。
# 默认 false —— 即使 NODE_ENV 漏配，注册也只给 free。
DEMO_ANNUAL_BY_DEFAULT=false
